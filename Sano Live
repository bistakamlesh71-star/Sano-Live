<style>
*{box-sizing:border-box}
body{margin:0;background:#080914;color:white;font-family:Arial}
header{padding:18px;display:flex;justify-content:space-between;align-items:center}
.logo{font-size:23px;font-weight:900;color:#ff38a5}
