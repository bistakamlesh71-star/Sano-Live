.card{height:260px;border-radius:20px;background-size:cover;background-position:center;position:relative;overflow:hidden}
.card:after{content:"";position:absolute;inset:0;background:linear-gradient(transparent,black)}
.tag,.name,.caption,.view{position:absolute;z-index:2}
.tag{top:10px;left:10px;background:#222;padding:7px;border-radius:20px;font-size:12px}
.live{background:#00c9e9}
.view{right:10px;top:10px;background:#222;padding:7px;border-radius:20px}
.name{bottom:38px;left:10px;font-weight:bold}
.caption{bottom:10px;left:10px;font-size:11px;background:#555;padding:5px;border-radius:15px}
.go{position:fixed;bottom:85px;right:15px;background:linear-gradient(90deg,#ff299d,#8844ff);color:white;border:0;border-radius:30px;padding:15px;font-weight:bold}
nav{position:fixed;bottom:0;background:#090a15;width:100%;height:72px;display:flex;justify-content:space-around;align-items:center;border-top:1px solid #25243a}
nav button{background:none;border:0;color:#aaa;font-size:11px}
nav b{display:block;font-size:22px}
